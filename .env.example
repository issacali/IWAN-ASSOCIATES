# Environment Configuration for IWAN ASSOCIATES Website

# 1. Node & Application Settings
NODE_ENV=production
# Render automatically sets PORT, but you can define it locally:
PORT=3000

# 2. Production URL (Update with your Render onrender.com domain)
NEXT_PUBLIC_SITE_URL=https://iwan-associates.onrender.com

# 3. Optional: Consultation Email Notification Settings
# If you wish to receive email notifications when a client fills out the consultation form:
# CONTACT_NOTIFICATION_EMAIL=advocates@iwanassociates.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
